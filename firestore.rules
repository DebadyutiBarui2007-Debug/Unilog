rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidMessage(data) {
      return data.keys().hasAll(['text', 'sender', 'createdAt', 'userId']) 
        && data.keys().size() == 4
        && data.text is string && data.text.size() <= 1000
        && data.sender is string && data.sender.size() <= 128
        && data.createdAt == request.time
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid;
    }

    match /users/{userId}/messages/{messageId} {
      allow read: if isSignedIn() && request.auth.uid == userId && isValidId(messageId);
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(messageId)
        && isValidMessage(incoming());
      // No updates or deletes for messages
    }
  }
}
